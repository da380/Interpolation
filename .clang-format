# Formatting for the Interpolation library.
#
# Written against clang-format 18, which is what CI enforces. Keep this file
# to the settings that actually differ from the base style; the previous
# version carried roughly 230 lines of commented-out Google configuration
# around a handful of live options.
---
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
ColumnLimit: 80
UseTab: Never
LineEnding: LF

AllowShortIfStatementsOnASingleLine: false
AlwaysBreakAfterReturnType: TopLevelDefinitions
SpaceAfterCStyleCast: true

AlignConsecutiveMacros: Consecutive
AlignTrailingComments: true
SpacesBeforeTrailingComments: 1
