PROJECT_NAME           = "Interpolation"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"
CREATE_SUBDIRS         = NO

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/README.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs"
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */_deps/*
EXAMPLE_PATH           = "@CMAKE_CURRENT_SOURCE_DIR@/examples"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/README.md"
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"

OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES

# The documentation contains LaTeX formulas. Without MathJax, Doxygen renders
# them to images by shelling out to latex, which makes a full TeX installation
# a build requirement and fails anywhere it is absent, CI included. MathJax
# renders them in the browser instead.
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
HAVE_DOT               = NO
